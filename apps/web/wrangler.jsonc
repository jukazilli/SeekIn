{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "seekin-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "env": {
    "preview": {
      "name": "seekin-web-preview",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "APP_ENV": "preview",
        "APP_ORIGIN": "https://seekin-web-preview.seekin-web.workers.dev",
        "APP_VERSION": "unreleased",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
      },
    },
    "beta": {
      "name": "seekin-web-beta",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "beta",
        "APP_ORIGIN": "https://seekin-web-beta.seekin-web.workers.dev",
        "APP_VERSION": "unreleased",
        "SUPABASE_URL": "https://wgxolsfirwqbkeluxaak.supabase.co",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEzGcfiiQNqEnkYl",
      },
      "secrets": {
        "required": ["SUPABASE_PUBLISHABLE_KEY"],
      },
    },
  },
}
