{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "seekin-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "env": {
    "preview": {
      "name": "seekin-web-preview",
      "workers_dev": true,
      "preview_urls": true,
    },
    "beta": {
      "name": "seekin-web-beta",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "beta",
        "SUPABASE_URL": "https://wgxolsfirwqbkeluxaak.supabase.co",
      },
      "secrets": {
        "required": ["SUPABASE_PUBLISHABLE_KEY"],
      },
    },
  },
}
