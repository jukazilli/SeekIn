APP_ENV=local
APP_ORIGIN=http://127.0.0.1:5173
APP_VERSION=0.1.0
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local-development-only

# Variaveis exclusivas de runtime servidor devem ser configuradas no provedor,
# nunca prefixadas com VITE_ e nunca preenchidas neste arquivo.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_local-development-only
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Used only by Supabase CLI when promoting Auth configuration.
# Never prefix these values with VITE_ or commit real credentials.
SUPABASE_AUTH_CAPTCHA_SECRET=1x0000000000000000000000000000000AA

