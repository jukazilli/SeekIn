{
  "name": "seekin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "build": "pnpm --filter @seekin/web build",
    "dev": "pnpm --filter @seekin/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "supabase:push:dry": "supabase db push --linked --dry-run",
    "supabase:push": "supabase db push --linked",
    "supabase:test": "supabase test db --linked supabase/tests/database"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.20.2",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "prettier": "3.9.0",
    "supabase": "2.117.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.0"
  }
}
